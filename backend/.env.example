# Backend-only AES-256-GCM master key: canonical Base64 encoding of 32 random bytes.
# Initialize only for a first installation; preserve existing matching keys.
# Put the result in backend/.env or the deployment secret configuration, never here.
# Keep this key backed up securely: replacing it makes existing encrypted keys unreadable.
# Read ../PRIVACY.md before deploying schema or migrating existing data.
AES_MASTER_KEY=

# Independent 32-byte Base64 HMAC key. Never reuse AES_MASTER_KEY.
CONTACT_SEARCH_KEY=

# Retain existing environment settings; do not overwrite a configured .env.
DATABASE_URL=file:./prisma/dev.db
JWT_SECRET=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_WEBHOOK_MODE=test
PAYMONGO_PAYMENT_METHODS=qrph
FRONTEND_URL=http://localhost:5173
PORT=3000
