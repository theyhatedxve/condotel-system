low: hidden;\n\n  color: var(--color-navy-950);\n\n  font-size: 11px;\n\n  text-overflow: ellipsis;\n\n  white-space: nowrap;\n}\n\n/* Style .topbar-search-result-title > span to set text appearance, style the surface and boundaries. */\n\n.topbar-search-result-title > span {\n  flex-shrink: 0;\n\n  padding: 2px 6px;\n\n  border-radius: 999px;\n\n  background: #edf1f4;\n\n  color: var(--color-text-muted);\n\n  font-size: 8px;\n  font-weight: 600;\n}\n\n/* Style .topbar-search-result-content > small to control overflowing content, arrange its contents, set text appearance. */\n\n.topbar-search-result-content > small {\n  display: block;\n\n  overflow: hidden;\n\n  margin-top: 4px;\n\n  color: var(--color-text-muted);\n\n  font-size: 9px;\n\n  text-overflow: ellipsis;\n\n  white-space: nowrap;\n}\n\n/* Style .topbar-search-result-meta to arrange its contents. */\n\n.topbar-search-result-meta {\n  display: flex;\n  align-items: center;\n\n  gap: 6px;\n\n  margin-top: 6px;\n}\n\n/* Style .topbar-search-result-meta span to set text appearance, style the surface and boundaries. */\n\n.topbar-search-result-meta span {\n  padding: 2px 5px;\n\n  border-radius: 4px;\n\n  background: #f6f8fa;\n\n  color: #63798e;\n\n  font-size: 8px;\n  font-weight: 600;\n}\n\n/* Style .topbar-search-empty to set text appearance. */\n\n.topbar-search-empty {\n  padding: 28px 16px;\n\n  color: var(--color-text-muted);\n\n  font-size: 11px;\n\n  text-align: center;\n}\n\n/* Style .topbar-actions to arrange its contents. */\n\n.topbar-actions {\n  display: flex;\n  align-items: center;\n\n  gap: 14px;\n}\n\n/* Style .topbar-icon-button, .topbar-profile to set text appearance, style the surface and boundaries. */\n\n.topbar-icon-button,\n.topbar-profile {\n  border: none;\n  background: transparent;\n\n  color: var(--color-navy-950);\n}\n\n/* Style .topbar-icon-button to arrange its contents. */\n\n.topbar-icon-button {\n  width: 36px;\n  height: 36px;\n\n  display: grid;\n  place-items: center;\n}\n\n/* Style .topbar-profile to arrange its contents. */\n\n.topbar-profile {\n  display: flex;\n  align-items: center;\n\n  gap: 8px;\n}\n\n/* Style .topbar-avatar to set text appearance. */\n\n.topbar-avatar {\n  width: 31px;\n  height: 31px;\n\n  font-size: 12px;\n}\n\n/* Style .admin-content to control spacing and dimensions. */\n\n.admin-content {\n  padding: 28px;\n}\n\n/* Style .admin-layout .admin-content > section, .admin-layout .dashboard-panel, .admin-layout .table-wrapper to control spacing and dimensions. */\n\n.admin-layout .admin-content > section,\n.admin-layout .dashboard-panel,\n.admin-layout .table-wrapper {\n  min-width: 0;\n}\n\n/* Reference theme: presentation only; existing feature controls stay in place. */\n.admin-layout .admin-content h1 {\n  color: #142f45;\n  font-size: 25px;\n  letter-spacing: -0.65px;\n  line-height: 1.3;\n}\n\n/* Style .admin-layout .admin-content > section > header > div > p, .admin-layout .admin-content > section > header > p to set text appearance. */\n\n.admin-layout .admin-content > section > header > div > p,\n.admin-layout .admin-content > section > header > p {\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n.admin-layout\n  :is(\n    .guest-table-wrapper,\n    .reservation-table-wrapper,\n    .payments-table-wrapper,\n    .transactions-table-wrapper,\n    .user-management-table-wrapper,\n    .settings-card,\n    .report-panel,\n    .payment-summary-card,\n    .transaction-summary-card,\n    .report-summary-card,\n    .user-management-summary-card,\n    .room-card\n  ) {\n  border-color: #e9edf3;\n  border-radius: 9px;\n  box-shadow: var(--shadow-card);\n  background: #ffffff;\n}\n\n/* Style .admin-layout .admin-content table th to set text appearance, style the surface and boundaries. */\n\n.admin-layout .admin-content table th {\n  padding: 14px 16px;\n  background: #f6f8fb;\n  color: #405469;\n  font-size: 12px;\n  font-weight: 600;\n  border-bottom: 1px solid #edf0f5;\n}\n\n/* Style .admin-layout .admin-con