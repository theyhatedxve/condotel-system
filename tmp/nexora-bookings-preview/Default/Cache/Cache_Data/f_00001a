ar-width));\n\n  margin-left: var(--sidebar-width);\n}\n\n/* Style .topbar to arrange its contents, position it within the page, style the surface and boundaries. */\n\n.topbar {\n  position: sticky;\n  top: 0;\n\n  z-index: 10;\n\n  height: 70px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  padding: 0 28px;\n\n  border-bottom: 1px solid var(--color-border);\n\n  background: rgba(255, 255, 255, 0.96);\n}\n\n/* Style .topbar-search to arrange its contents, position it within the page, set text appearance. */\n\n.topbar-search {\n  position: relative;\n  width: min(100%, 360px);\n\n  display: flex;\n  align-items: center;\n\n  gap: 9px;\n\n  color: #8497a9;\n  padding: 0 12px;\n  border: 1px solid #edf0f5;\n  border-radius: 7px;\n  background: #ffffff;\n}\n\n/* Style .topbar-search input to make keyboard focus visible, style the surface and boundaries. */\n\n.topbar-search input {\n  width: 100%;\n\n  padding: 8px 0;\n\n  border: none;\n\n  border-bottom: 0;\n\n  outline: none;\n\n  background: transparent;\n}\n\n/* Style .topbar-search-spinner to control spacing and dimensions. */\n\n.topbar-search-spinner {\n  flex-shrink: 0;\n\n  animation: topbar-search-spin 0.8s linear infinite;\n}\n\n/* Style .topbar-search-dropdown to control spacing and dimensions. */\n\n.topbar-search-dropdown {\n  width: calc(100vw - var(--sidebar-width) - 48px);\n}\n\n/* Style .topbar-notifications to position it within the page. */\n\n.topbar-notifications {\n  position: relative;\n}\n\n/* Style .topbar-icon-button to position it within the page. */\n\n.topbar-icon-button {\n  position: relative;\n}\n\n/* Style .topbar-notification-badge to keep padding and borders inside the declared dimensions, arrange its contents, position it within the page. */\n\n.topbar-notification-badge {\n  position: absolute;\n\n  top: 1px;\n  right: 0;\n\n  min-width: 16px;\n  height: 16px;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  padd