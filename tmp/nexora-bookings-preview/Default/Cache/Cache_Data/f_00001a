ight: 390px;\n\n  overflow-y: auto;\n}\n\n/* Style .notification-item to indicate the available pointer interaction, arrange its contents, style the surface and boundaries. */\n\n.notification-item {\n  width: 100%;\n\n  display: flex;\n  align-items: flex-start;\n\n  gap: 10px;\n\n  padding: 12px 13px;\n\n  border: none;\n\n  border-bottom: 1px solid #edf2f6;\n\n  background: #ffffff;\n\n  text-align: left;\n\n  cursor: pointer;\n}\n\n/* Style .notification-item:last-child to control spacing and dimensions. */\n\n.notification-item:last-child {\n  border-bottom: none;\n}\n\n/* Style .notification-item:hover to style the surface and boundaries. */\n\n.notification-item:hover {\n  background: #f7fafc;\n}\n\n/* Style .notification-item.unread to style the surface and boundaries. */\n\n.notification-item.unread {\n  background: #f3f8fd;\n}\n\n/* Style .notification-item.unread:hover to style the surface and boundaries. */\n\n.notification-item.unread:hover {\n  background: #edf5fc;\n}\n\n/* Style .notification-item-icon to arrange its contents, set text appearance, style the surface and boundaries. */\n\n.notification-item-icon {\n  width: 34px;\n  height: 34px;\n\n  display: grid;\n  place-items: center;\n\n  flex-shrink: 0;\n\n  border-radius: 8px;\n\n  background: #eaf4fd;\n\n  color: var(--color-blue-700);\n}\n\n/* Style .notification-item-content to control spacing and dimensions. */\n\n.notification-item-content {\n  min-width: 0;\n\n  flex: 1;\n}\n\n/* Style .notification-item-title to arrange its contents. */\n\n.notification-item-title {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 8px;\n}\n\n/* Style .notification-item-title strong to set text appearance. */\n\n.notification-item-title strong {\n  color: var(--color-navy-950);\n\n  font-size: 11px;\n}\n\n/* Style .notification-item-title i to style the surface and boundaries. */\n\n.notification-item-title i {\n  width: 7px;\n  height: 7px;\n\n  flex-shrink: 0;\n\n  border-radius: 50%;\n\n  background: var(--color-blue-700);\n}\n\n/* Style .notification-item p to set text appearance. */\n\n.notification-item p {\n  margin: 4px 0 0;\n\n  color: var(--color-text-muted);\n\n  font-size: 9px;\n  line-height: 1.45;\n}\n\n/* Style .notification-item small to arrange its contents, set text appearance. */\n\n.notification-item small {\n  display: block;\n\n  margin-top: 6px;\n\n  color: #91a1af;\n\n  font-size: 8px;\n}\n\n/* Style .notification-empty to set text appearance. */\n\n.notification-empty {\n  padding: 32px 18px;\n\n  color: var(--color-text-muted);\n\n  font-size: 10px;\n\n  text-align: center;\n}\n\n/* Apply the following layout adjustments when (max-width: 650px). */\n\n@media (max-width: 650px) {\n  /* Style .notification-dropdown to control spacing and dimensions. */\n  .notification-dropdown {\n    width: min(360px, calc(100vw - 110px));\n  }\n}\n\n@keyframes topbar-search-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* Style .topbar-search-dropdown to control overflowing content, position it within the page, set text appearance. */\n\n.topbar-search-dropdown {\n  position: absolute;\n\n  top: calc(100% + 12px);\n\n  left: 0;\n\n  z-index: 30;\n\n  width: min(480px, calc(100vw - var(--sidebar-width) - 80px));\n\n  max-height: 440px;\n\n  overflow: hidden;\n\n  border: 1px solid var(--color-border);\n\n  border-radius: var(--radius-md);\n\n  background: #ffffff;\n\n  color: var(--color-navy-950);\n\n  box-shadow: 0 18px 45px rgba(15, 23, 42, 0.14);\n}\n\n/* Style .topbar-search-dropdown-header to arrange its contents, style the surface and boundaries. */\n\n.topbar-search-dropdown-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 12px;\n\n  padding: 12px 14px;\n\n  border-bottom: 1px solid var(--color-border);\n\n  background: #f8fafc;\n}\n\n/* Style .topbar-search-dropdown-header span to set text appearance. */\n\n.topbar-search-dropdown-header span {\n  font-si